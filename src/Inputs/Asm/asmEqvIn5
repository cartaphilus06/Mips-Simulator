main:
    addi $t0, $zero, 5
    addi $s0, $zero, 0
PushLoop:
    beq $t0, $zero, PopInit
    addi $sp, $sp, -4
    sw $t0, $sp, 0
    addi $t0, $t0, -1
    j PushLoop
PopInit:
    addi $t1, $zero, 5
PopLoop:
    beq $t1, $zero, end
    lw $t2, $sp, 0
    add $s0, $s0, $t2
    addi $sp, $sp, 4
    addi $t1, $t1, -1
    j PopLoop
end:
    sw $s0, $zero, 0